# Texto com quebra de linha normalizada no repositório
* text=auto

# Scripts do Windows precisam de CRLF; o resto, LF
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.pyw  text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.yml  text eol=lf
*.spec text eol=lf
*.wxs  text eol=lf
*.svg  text eol=lf
*.txt  text eol=lf

# Binários
*.png  binary
*.ico  binary
*.msi  binary
*.jpg  binary
